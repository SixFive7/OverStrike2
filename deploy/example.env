# Your secrets for deploy/compose.yml. Copy this file to deploy/.env (gitignored; docker compose reads it from the compose file's
# folder) and fill it in. Never commit the filled copy. The HUD's Workshop id is no secret and is not here: hud.addon in overstrike2.jsonc,
# which the example file has. It is required: without it the game server's container does not start, and its log says why.

# A long random password. Only the bridge uses RCON, inside the compose network.
CS2_RCONPW=

# Letters and digits. The game server's log push, the restart notices and the sync's posts to the bridge carry it.
OVERSTRIKE2_BRIDGE_SECRET=

# Optional: a Game Server Login Token (app 730) lists the server publicly; empty runs it unlisted (direct connects work).
SRCDS_TOKEN=

# The name players see.
CS2_SERVERNAME="Over Strike 2"

# Local time in every container: the daily restart and the logs.
TZ=Etc/UTC
