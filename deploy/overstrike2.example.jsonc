// Over Strike 2 - the settings file every part reads: the bridge, the plugin and the server program (the restart watcher and the
// Workshop sync). docs/settings.md describes every key, its default and who reads it; a key you leave out has its default. JSON with
// comments and trailing commas. A string "env:NAME" is read from the environment variable NAME, "file:PATH" from that file - the
// way to keep a secret where it is kept already (the game image's own variables, a mounted secret file).
//
// With docker compose, either inline in the compose file, as a multi-line environment variable of each of the three services:
//
//   x-settings: &settings |
//     { "schema": 1, ... }
//   services:
//     cs2:
//       environment:
//         OVERSTRIKE2_SETTINGS_CONTENT: *settings
//
// or as this file beside it (configs: overstrike2: file: ./overstrike2.jsonc, as compose.yml does), and in each of the three services:
//
//   configs:
//     - source: overstrike2
//       target: /etc/overstrike2/overstrike2.jsonc
//
// Not an inline compose config (configs: content:): it does not run on a read-only service and is lost at a recreate from inspect.
{
  "schema": 1,
  "server": {
    "name": "My CS2 server",               // in the sync's mails and on the dashboard
    "host": "cs2",                         // the game server's container name, as the bridge and the sync reach it
    "port": 27015,                         // the same as the game image's CS2_PORT
    "rconPassword": "env:CS2_RCONPW",      // the game image needs CS2_RCONPW anyway: give the bridge the same variable
    "startMap": "ar_shoots",               // the same as the game image's CS2_STARTMAP
  },
  "bridge": {
    "url": "http://bridge:8080",           // how the game server and the sync reach the bridge
    "port": 8080,
    "secret": "env:OVERSTRIKE2_BRIDGE_SECRET",   // letters and digits; the game image's CS2_LOG_HTTP_URL is <url>/log/<secret>
    "admins": [],                          // SteamID64s of the players who may use the admin commands
    "discoveryStock": 10,                  // per mode, maps new to the server rolled ahead and downloaded in the background; 0 for none
  },
  "hud": {
    "addon": "3823993566",                 // required: the Over Strike 2 HUD on the Steam Workshop; without it the game server does not start
    "tab": "down",                         // down: TAB puts the board down while held; off
    "check": "warn",                       // off, warn, or enforce (disconnect a player whose game has not loaded the HUD)
  },
  "restarts": {
    "daily": "07:00",                      // local time (the containers' TZ), only while nobody is on; "off" for none
  },
  "paths": {
    "syncCfg": "/home/steam/sync-cfg",     // the mode cfgs the sync's test engine loads maps with (deploy/compose.yml mounts them there)
  },
  "sync": {
    "webApiKey": "file:/run/secrets/steam-webapi-key.txt",   // your Steam Web API key; without one, discovery and the ratings are skipped
    "excludeCreators": [],                 // SteamID64s of authors whose maps you list by hand (your own)
    "mail": {
      "smtpHost": "",                      // an SMTP relay for the problem mails; "" sends none
      "from": "",
      "to": [],
      "dashboardUrl": "",
    },
  },
}
