<Project Sdk="Microsoft.NET.Sdk">

  <!-- Over Strike 2: the server's one CounterStrikeSharp plugin - the HUD and the menu, the chat commands, the vote's freeze, the grenade
       drops, the settings module (a map's settings put back, the game-changers block, the fun page's changes), catch-up and the game
       modes, as modules of one plugin, so the fun page's effects, the block's notices and the game mode are one plugin's state. The
       folder name, the DLL name and the plugin's name are the same: OverStrike2. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CounterStrikeSharp 1.0.379 marks the ConVar class obsolete in favour of ConVar<T> (#935); it still works, unchanged. The settings
         module finds and writes the game's own convars by name through it, so the warning is off until the move to ConVar<T>. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the CounterStrikeSharp release os2-server installs (server/OverStrike2.Server/Install.cs). 1.0.376 is the first that keeps per-player HUD text after
         a join (#1434). -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" />
    <!-- The logic and the words live with the bridge, which tests them in its selftest; compiled in here as source. -->
    <Compile Include="..\..\bridge\Guide.cs" Link="Guide.cs" />
    <Compile Include="..\..\bridge\Hud.cs" Link="Hud.cs" />
    <Compile Include="..\..\bridge\HudBrowser.cs" Link="HudBrowser.cs" />
    <Compile Include="..\..\bridge\HudThumbList.cs" Link="HudThumbList.cs" />
    <Compile Include="..\..\bridge\HudCheck.cs" Link="HudCheck.cs" />
    <Compile Include="..\..\bridge\HudTab.cs" Link="HudTab.cs" />
    <Compile Include="..\..\bridge\Workshop.cs" Link="Workshop.cs" />
    <Compile Include="..\..\bridge\HudSearch.cs" Link="HudSearch.cs" />
    <Compile Include="..\..\bridge\HudWorkshop.cs" Link="HudWorkshop.cs" />
    <Compile Include="..\..\bridge\Fun.cs" Link="Fun.cs" />
    <Compile Include="..\..\bridge\BlockList.cs" Link="BlockList.cs" />
    <Compile Include="..\..\bridge\MapVote.cs" Link="MapVote.cs" />
    <Compile Include="..\..\bridge\Modes.cs" Link="Modes.cs" />
    <Compile Include="..\..\bridge\MatchLength.cs" Link="MatchLength.cs" />
    <Compile Include="..\..\bridge\HudVote.cs" Link="HudVote.cs" />
    <Compile Include="..\..\bridge\HudDash.cs" Link="HudDash.cs" />
    <Compile Include="..\..\bridge\ChatCommands.cs" Link="ChatCommands.cs" />
    <!-- The settings file: core's reader, compiled in as source like the bridge's files (no second DLL beside the plugin), and where the
         plugin's settings come from while the install step does not write the file yet (PluginSetup.cs). -->
    <Compile Include="..\..\core\Settings.cs" Link="Core\Settings.cs" />
    <Compile Include="..\..\bridge\SettingsSource.cs" Link="SettingsSource.cs" />
    <!-- The message catalogue (surfaces, chat and board copies), shared with the bridge. -->
    <Compile Include="..\..\bridge\Messages.cs" Link="Messages.cs" />
    <!-- The catch-up module: its rules, config and game half compiled in as source; its config beside the DLL. -->
    <Compile Include="..\CatchUp\CatchUpConfig.cs" Link="CatchUp\CatchUpConfig.cs" />
    <Compile Include="..\CatchUp\CatchUpRules.cs" Link="CatchUp\CatchUpRules.cs" />
    <Compile Include="..\CatchUp\Ladder.cs" Link="CatchUp\Ladder.cs" />
    <Compile Include="..\CatchUp\CatchUpWords.cs" Link="CatchUp\CatchUpWords.cs" />
    <Compile Include="..\CatchUp\CatchUpModule.cs" Link="CatchUp\CatchUpModule.cs" />
    <None Include="..\CatchUp\catchup.json" Link="catchup.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The names of every game convar (FCVAR_GAMEDLL, "sv" in cvarlist) on CS2 1.41.9.1/14191, and the same 1,555 on 1.41.9.2/14192
         (regenerated 2026-10-24) and on 1.41.9.4/14194 (2026-11-01; no name added or gone). The floor of the settings module's list: at every
         start it also asks the running build for the game convars this list lacks (ConVarNames.cs), and it falls back on this list alone if
         that fails. A CS2 update therefore needs no new list; to refresh it anyway, run cvarlist over RCON, read the reply to its end
         (its last line gives the count) and keep the name of every line whose second column is not cmd and whose flags column has sv, sorted. -->
    <EmbeddedResource Include="convars.txt" LogicalName="convars.txt" />
    <!-- The block list, every game mode's in one file, is a config file beside the DLL (deploy both): editing it needs no rebuild,
         "mapreset_block reload" reads it. -->
    <None Include="blocked.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
