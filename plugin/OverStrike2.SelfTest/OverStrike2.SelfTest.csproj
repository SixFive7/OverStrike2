<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OverStrike2.SelfTest</AssemblyName>
    <RootNamespace>OverStrike2.SelfTest</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The decisions under test, compiled in source rather than referenced: none of these files mentions a CounterStrikeSharp type, so this
         project needs neither the NuGet package nor a game server - `dotnet run` is the whole test suite. Everything else in the plugin only
         exists once a CS2 server has loaded it. -->
    <!-- The settings module's question to the running build: the engine is faked. The real list comes along, to hold the question's rules to it. -->
    <Compile Include="..\OverStrike2\ConVarNames.cs" Link="ConVarNames.cs" />
    <!-- The Web API's one door (one request at a time, 2 s apart, an honest User-Agent). -->
    <Compile Include="..\OverStrike2\SteamWebApi.cs" Link="SteamWebApi.cs" />
    <!-- When the vote freezes everybody, on a handed clock. -->
    <Compile Include="..\OverStrike2\FreezePlan.cs" Link="FreezePlan.cs" />
    <!-- The Players page's time on: whose it is. -->
    <Compile Include="..\OverStrike2\JoinTimes.cs" Link="JoinTimes.cs" />
    <!-- The plugin's settings: core's reader, and what the plugin takes from it. -->
    <Compile Include="..\..\core\Settings.cs" Link="Core\Settings.cs" />
    <Compile Include="..\OverStrike2\PluginSetup.cs" Link="PluginSetup.cs" />
    <!-- Whom the spawn cloak hides, on handed ticks and positions, and which entities the cloak has painted and puts back. -->
    <Compile Include="..\OverStrike2\CloakPlan.cs" Link="CloakPlan.cs" />
    <!-- What the plugin shares with the bridge - the block file's format and every game mode's values (Modes.cs, BlockList.cs), the fun page's
         settings and the players' changes (Fun.cs, FunState.cs) - compiled in as the plugin compiles it, with core's rule the map browser's
         search takes: plain BCL all of it, tested by the bridge's own self-test as well. -->
    <Compile Include="..\..\bridge\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="..\..\core\SearchText.cs" Link="Core\SearchText.cs" />
    <!-- The fun page's switches: a player's change, the effects, the undo. -->
    <Compile Include="..\OverStrike2\FunSwitches.cs" Link="FunSwitches.cs" />
    <!-- The game-changers block, on fake convars and a handed clock, and the engine's revert of cheat-flagged settings when cheats go off. -->
    <Compile Include="..\OverStrike2\GameChangerBlock.cs" Link="GameChangerBlock.cs" />
    <Compile Include="..\OverStrike2\CheatsRevert.cs" Link="CheatsRevert.cs" />
    <!-- Which game mode the settings module acts in, at a map start, at os_mode and at a load while a map is on. -->
    <Compile Include="..\OverStrike2\ModePlan.cs" Link="ModePlan.cs" />
    <EmbeddedResource Include="..\OverStrike2\convars.txt" LogicalName="convars.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The block logs through ILogger, as every module of the plugin does: the abstractions alone, the version CounterStrikeSharp brings. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
