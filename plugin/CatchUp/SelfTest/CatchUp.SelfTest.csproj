<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CatchUp.SelfTest</AssemblyName>
    <RootNamespace>CatchUp.SelfTest</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The decisions under test, compiled in source: neither file mentions a CounterStrikeSharp type, so this project needs neither
         the NuGet package nor a game server. `dotnet run -c Release` is the whole suite. -->
    <Compile Include="..\CatchUpConfig.cs" Link="CatchUpConfig.cs" />
    <Compile Include="..\CatchUpRules.cs" Link="CatchUpRules.cs" />
    <!-- The shipped config, checked against the built-in defaults; and five real matches, replayed through the kill counter. -->
    <None Include="..\catchup.json" Link="catchup.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="armsrace-2026-09-19.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="armsrace-2026-11-04.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
