<Project Sdk="Microsoft.NET.Sdk">

  <!-- A compile check, not a plugin: the module has no BasePlugin of its own and this DLL is never deployed. The host plugin compiles
       these sources into itself. Same settings as the host's csproj, so what builds here builds there. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the CounterStrikeSharp release installed by server/pre.sh, like the other plugins. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" />
    <!-- SelfTest/ is its own program (no CounterStrikeSharp): not part of the module. -->
    <Compile Remove="SelfTest\**" />
    <None Remove="SelfTest\**" />
    <None Update="catchup.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
