<Project Sdk="Microsoft.NET.Sdk">

  <!-- os2-sync: the Workshop sync, in its own container (the game server's image: its SteamCMD, the libraries a test engine needs).
       `serve` (the service: a run whenever nobody plays and there is work), `once` (one run now), `status`, `export` and `doctor`.
       Shipped as one self-contained linux-x64 file: dotnet publish -c Release -r linux-x64 (the properties below make it a single file
       with its runtime; JIT, not AOT, so it runs on any glibc from 2.27). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- LibraryImport's generated marshalling: kill and statvfs -->
    <RootNamespace>OverStrike2.Sync</RootNamespace>
    <AssemblyName>os2-sync</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\OverStrike2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The self-test is a project of its own in the folder below. -->
    <Compile Remove="SelfTest\**" />
    <None Remove="SelfTest\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scan reads map entity lumps in Zstandard (Scan.Kv3Strings, release 197), which .NET has no decoder for: a managed port, MIT (NOTICE). -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
