							<Label id="gg_w_map" class="gg-map gg-map-big" text="{s:text}" />
							<Label id="gg_w_by" class="gg-by" text="{s:text}" />
							<Panel class="gg-vote-buttons">
								<Button id="gg_btn_up" class="gg-vote gg-vote-up">
									<Panel class="gg-chev" />
									<Label class="gg-vote-word" text="Like" />
									<Label id="gg_w_up" class="gg-vote-num" text="{s:text}" />
								</Button>
								<Button id="gg_btn_down" class="gg-vote gg-vote-down">
									<Panel class="gg-chev gg-chev-down" />
									<Label class="gg-vote-word" text="Dislike" />
									<Label id="gg_w_down" class="gg-vote-num" text="{s:text}" />
								</Button>
							</Panel>
							<Label id="gg_w_status" class="gg-status" text="{s:text}" />
							<Button id="gg_btn_act" class="gg-act">
								<Label id="gg_btn_act_text" class="gg-act-text" text="{s:text}" />
								<Label id="gg_btn_act_sub" class="gg-act-sub" text="{s:text}" />
							</Button>

							<Label class="gg-label" text="Up next" />
							<Panel class="gg-list">
								<Panel id="gg_w_row_n1" class="gg-row"><Label class="gg-row-num" text="1" /><Label id="gg_w_n1" class="gg-row-map" text="{s:text}" /><Label id="gg_w_nw1" class="gg-row-side" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_n2" class="gg-row"><Label class="gg-row-num" text="2" /><Label id="gg_w_n2" class="gg-row-map" text="{s:text}" /><Label id="gg_w_nw2" class="gg-row-side" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_n3" class="gg-row"><Label class="gg-row-num" text="3" /><Label id="gg_w_n3" class="gg-row-map" text="{s:text}" /><Label id="gg_w_nw3" class="gg-row-side" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_n4" class="gg-row"><Label class="gg-row-num" text="4" /><Label id="gg_w_n4" class="gg-row-map" text="{s:text}" /><Label id="gg_w_nw4" class="gg-row-side" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_n5" class="gg-row"><Label class="gg-row-num" text="5" /><Label id="gg_w_n5" class="gg-row-map" text="{s:text}" /><Label id="gg_w_nw5" class="gg-row-side" text="{s:text}" /></Panel>
								<Label id="gg_w_nempty" class="gg-empty" text="{s:text}" />
							</Panel>

							<Label class="gg-label" text="Most liked" />
							<Panel class="gg-list">
								<Panel id="gg_w_row_t1" class="gg-row"><Label class="gg-row-num" text="1" /><Label id="gg_w_t1" class="gg-row-map" text="{s:text}" /><Label id="gg_w_ts1" class="gg-row-side gg-row-score" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_t2" class="gg-row"><Label class="gg-row-num" text="2" /><Label id="gg_w_t2" class="gg-row-map" text="{s:text}" /><Label id="gg_w_ts2" class="gg-row-side gg-row-score" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_t3" class="gg-row"><Label class="gg-row-num" text="3" /><Label id="gg_w_t3" class="gg-row-map" text="{s:text}" /><Label id="gg_w_ts3" class="gg-row-side gg-row-score" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_t4" class="gg-row"><Label class="gg-row-num" text="4" /><Label id="gg_w_t4" class="gg-row-map" text="{s:text}" /><Label id="gg_w_ts4" class="gg-row-side gg-row-score" text="{s:text}" /></Panel>
								<Panel id="gg_w_row_t5" class="gg-row"><Label class="gg-row-num" text="5" /><Label id="gg_w_t5" class="gg-row-map" text="{s:text}" /><Label id="gg_w_ts5" class="gg-row-side gg-row-score" text="{s:text}" /></Panel>
								<Label id="gg_w_tempty" class="gg-empty" text="{s:text}" />
							</Panel>
						</Panel>
					</Panel>

					<Panel class="gg-win-foot">
						<Label id="gg_f_site" class="gg-foot-site" text="{s:text}" />
						<Panel class="gg-drain">
							<Label class="gg-drain-word" text="Closes when idle" />
							<Panel class="gg-drain-track"><Panel class="gg-drain-fill" /></Panel>
						</Panel>
					</Panel>
				</Panel>

				<!-- Last, so they draw above the dim layer and the window. 4. The news: what just happened, for everybody (a pick, a skip vote, the queue moving, a crash, a restart) -->
				<Panel class="gg-news" hittest="false">
					<Panel class="gg-news-mark" />
					<Label id="gg_news_text" class="gg-news-text" text="{s:text}" />
				</Panel>

				<!-- 5. The note: the answer to this player's own click, for them alone (a refusal, a confirmation to give) -->
				<Panel class="gg-note" hittest="false">
					<Label id="gg_note_text" class="gg-note-text" text="{s:text}" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
