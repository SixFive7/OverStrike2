						<Panel class="gg-live-dot" />
					</Panel>
					<Label class="gg-label" text="Now playing" />
					<Label id="gg_b_map" class="gg-map" text="{s:text}" />
					<Label id="gg_b_by" class="gg-by" text="{s:text}" />
					<Panel class="gg-vote-buttons">
						<Button id="gg_b_vup" class="gg-vote gg-vote-up">
							<Panel class="gg-chev" />
							<Label class="gg-vote-word" text="Like" />
							<Label id="gg_b_up" class="gg-vote-num" text="{s:text}" />
						</Button>
						<Button id="gg_b_vdown" class="gg-vote gg-vote-down">
							<Panel class="gg-chev gg-chev-down" />
							<Label class="gg-vote-word" text="Dislike" />
							<Label id="gg_b_down" class="gg-vote-num" text="{s:text}" />
						</Button>
					</Panel>
					<Label id="gg_b_you" class="gg-you" text="{s:text}" />
					<Label id="gg_b_status" class="gg-status" text="{s:text}" />
					<Button id="gg_b_next" class="gg-act">
						<Label id="gg_b_next_text" class="gg-act-text" text="{s:text}" />
						<Label id="gg_b_next_sub" class="gg-act-sub" text="{s:text}" />
					</Button>

					<Label class="gg-label" text="Queue" />
					<Label id="gg_b_queue" class="gg-bqueue" text="{s:text}" />

					<Button id="gg_b_open" class="gg-board-open">
						<Label class="gg-board-open-text" text="Open full menu" />
						<Label class="gg-board-open-key" text="TAB + E" />
					</Button>
					<Panel class="gg-board-foot">
						<Label id="gg_b_cmds" class="gg-foot-cmds" text="{s:text}" />
						<Label id="gg_b_count" class="gg-foot-site" text="{s:text}" />
					</Panel>
				</Panel>

				<!-- 2. The card: now playing / welcome back -->
				<Panel class="gg-toast" hittest="false">
					<Panel class="gg-toast-mark">
						<Panel class="gg-knife gg-knife-toast" />
					</Panel>
					<Panel class="gg-toast-body">
						<Label id="gg_t_eyebrow" class="gg-eyebrow" text="{s:text}" />
						<Label id="gg_t_map" class="gg-toast-map" text="{s:text}" />
						<Label id="gg_t_by" class="gg-by" text="{s:text}" />
						<Label id="gg_t_hint" class="gg-toast-hint" text="{s:text}" />
					</Panel>
				</Panel>

				<!-- 3. The banner: a map change counting down -->
