<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>os2-bridge</AssemblyName> <!-- as os2-server, os2-sync and os2-deploy: the image runs /app/os2-bridge -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- core/: the settings file's reader (BridgeConfig.cs) - what the bridge shares with the plugin and the server programs. -->
    <ProjectReference Include="..\core\OverStrike2.Core.csproj" />
    <!-- The website of the sync's dashboard (SyncDash.cs writes it into /data/web, which a static web server behind the login serves). -->
    <EmbeddedResource Include="dashboard.html" LogicalName="dashboard.html" />
  </ItemGroup>

</Project>
