<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway test plugin for the documentation's screenshots (os2-deploy docshots name): loaded from /tmp on the insecure test copy only, never copied to
       the plugins folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
