<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway test plugin for the lab (os2-deploy docshots full): loaded from /tmp on the insecure test copy only, never copied to the plugins folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CounterStrikeSharp release os2-server installs (server/OverStrike2.Server/Install.cs): the API the copy runs. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.381">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
