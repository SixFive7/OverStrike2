<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only probe for the CS2 client test harness (../../README.md). Never copied to the server's plugins folder: probe.py loads it
       from /tmp in the game container for one test and removes it after. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- CounterStrikeSharp.API, as the server's plugin builds against it (plugin/OverStrike2); provided by the server install at run time. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
