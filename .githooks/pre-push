#!/bin/sh
# Over Strike 2: scan every commit about to be pushed - its files, its message, its author and committer - before anything
# leaves this machine (tools/scan/scan.py). A finding stops the push. Never bypass this with --no-verify.
root=$(git rev-parse --show-toplevel) || exit 1
py=$(command -v python || command -v python3 || command -v py) || { echo "pre-push: Python not found - the scan cannot run" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                      # a deletion pushes no content
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
    "$py" -I "$root/tools/scan/scan.py" --range "$range" || status=1
done
exit $status
